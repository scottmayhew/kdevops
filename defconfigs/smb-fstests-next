# CONFIG_KDEVOPS_BASELINE_AND_DEV is not set

#
# Ansible post-bring up provisioning configuration
#
CONFIG_KDEVOPS_PLAYBOOK_DIR="playbooks"
CONFIG_KDEVOPS_ANSIBLE_PROVISION_ENABLE=y
CONFIG_KDEVOPS_ANSIBLE_PROVISION_PLAYBOOK="devconfig.yml"
CONFIG_KDEVOPS_DEVCONFIG_ENABLE=y
CONFIG_KDEVOPS_DEVCONFIG_ENABLE_CONSOLE=y
CONFIG_KDEVOPS_DEVCONFIG_KERNEL_CONSOLE_SETTINGS="console=tty0 console=tty1 console=ttyS0,115200n8"
CONFIG_KDEVOPS_DEVCONFIG_GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --parity=no --stop=1"
CONFIG_KDEVOPS_GRUB_TIMEOUT=2
CONFIG_KDEVOPS_DEVCONFIG_ENABLE_SYSTEMD_WATCHDOG=y
CONFIG_KDEVOPS_DEVCONFIG_SYSTEMD_WATCHDOG_TIMEOUT_RUNTIME="5min"
CONFIG_KDEVOPS_DEVCONFIG_SYSTEMD_WATCHDOG_TIMEOUT_REBOOT="10min"
CONFIG_KDEVOPS_DEVCONFIG_SYSTEMD_WATCHDOG_TIMEOUT_KEXEC="5min"
CONFIG_KDEVOPS_PYTHON_INTERPRETER="/usr/bin/python3"
CONFIG_KDEVOPS_PYTHON_OLD_INTERPRETER="/usr/bin/python2"
# CONFIG_DEVCONFIG_ENABLE_SYSTEMD_JOURNAL_REMOTE is not set
# CONFIG_DEVCONFIG_ENABLE_SYSTEMD_TIMESYNCD is not set
# CONFIG_KDEVOPS_DEVCONFIG_ENABLE_CUSTOM_REPOS is not set
# end of Ansible post-bring up provisioning configuration

#
# Ansible Configuration
#
# CONFIG_ANSIBLE_CFG_FILE_CUSTOM is not set

#
# Ansible Callback Plugin Configuration
#
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_LUCID is not set
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_DEBUG is not set
CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_DENSE=y
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_DIY is not set
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_CUSTOM is not set
CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_STRING="dense"
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_CHECK_MODE_MARKERS is not set
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_DISPLAY_FAILED_STDERR is not set
CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_DISPLAY_OK_HOSTS=y
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_DISPLAY_SKIPPED_HOSTS is not set
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_SHOW_CUSTOM_STATS is not set
CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_SHOW_PER_HOST_START=y
CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_SHOW_TASK_PATH_ON_FAILURE=y
# CONFIG_ANSIBLE_CFG_CALLBACK_PLUGIN_PROFILE_TASKS is not set
# end of Ansible Callback Plugin Configuration

CONFIG_ANSIBLE_CFG_VERBOSITY=0
CONFIG_ANSIBLE_CFG_DEPRECATION_WARNINGS=y

#
# Ansible Python Interpreter
#
# CONFIG_ANSIBLE_CFG_INTERPRETER_PYTHON_AUTO is not set
# CONFIG_ANSIBLE_CFG_INTERPRETER_PYTHON_AUTO_LEGACY is not set
# CONFIG_ANSIBLE_CFG_INTERPRETER_PYTHON_AUTO_LEGACY_CLIENT is not set
CONFIG_ANSIBLE_CFG_INTERPRETER_PYTHON_AUTO_SILENT=y
# CONFIG_ANSIBLE_CFG_INTERPRETER_PYTHON_CUSTOM is not set
CONFIG_ANSIBLE_CFG_INTERPRETER_PYTHON_STRING="auto_silent"
# end of Ansible Python Interpreter

# CONFIG_ANSIBLE_CFG_FORKS_CUSTOM is not set
CONFIG_ANSIBLE_CFG_FORKS=10
# CONFIG_ANSIBLE_CFG_TASK_DEBUGGER is not set
# CONFIG_ANSIBLE_CFG_INVENTORY_CUSTOM is not set
# CONFIG_ANSIBLE_CFG_SSH_PORT_CUSTOM is not set
CONFIG_ANSIBLE_CFG_SSH_PORT=22
# end of Ansible Configuration
# end of Kdevops configuration
